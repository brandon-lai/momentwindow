// The edge worker: the page, location and snapping, scene cache, weather,
// search and postcards. The scene builder runs on Vercel (see README).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "momentwindow",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../dist/client", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "SCENES", "id": "9a98f4011938411a998092944fd94ca3" }],
  "vars": {
    "BUILDER_URL": "https://momentwindow-builder.vercel.app/api/scene",
    "BUNDLE_VERSION": "1"
  },
  "observability": { "enabled": true }
}
